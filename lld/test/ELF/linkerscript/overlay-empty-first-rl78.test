# REQUIRES: rl78
## The first section of an OVERLAY is kept even when it is empty (the other
## overlay sections take their address from it). On RL78 such an empty
## section needs no memory region; other targets still report it.
# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -filetype=obj -triple=rl78 a.s -o rl78.o
# RUN: ld.lld rl78.o -T a.t -o rl78
# RUN: llvm-readelf -S rl78 | FileCheck %s
# CHECK: .text     PROGBITS 00000100
# CHECK: .out.big  PROGBITS 00001000 {{.*}} 000000

## A non-empty overlay section still needs a region.
# RUN: llvm-mc -filetype=obj -triple=rl78 b.s -o b.o
# RUN: not ld.lld rl78.o b.o -T a.t -o /dev/null 2>&1 | FileCheck %s --check-prefix=ERR
# ERR: error: no memory region specified for section '.out.big'

#--- a.s
.text
.global _start
_start: ret

#--- b.s
.section .big,"a"
.byte 1

#--- a.t
MEMORY { ROM : ORIGIN = 0x100, LENGTH = 0x8000 }
SECTIONS {
  .text : { *(.text) } >ROM
  OVERLAY 0x1000 : AT (0x5000) {
    .out.big { *(.big) }
    .out.small { *(.small) }
  }
}
