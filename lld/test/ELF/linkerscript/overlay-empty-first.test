# REQUIRES: x86
## The first section of an OVERLAY is kept even when it is empty (the other
## overlay sections take their address from it). Such an empty section needs
## no memory region.
# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -filetype=obj -triple=x86_64 a.s -o a.o
# RUN: ld.lld a.o -T a.t -o a
# RUN: llvm-readelf -S a | FileCheck %s
# CHECK: .text     PROGBITS {{0+}}100
# CHECK: .out.big  PROGBITS {{0+}}1000 {{[0-9a-f]+}} 000000

## A non-empty overlay section still needs a region.
# RUN: llvm-mc -filetype=obj -triple=x86_64 b.s -o b.o
# RUN: not ld.lld a.o b.o -T a.t -o /dev/null 2>&1 | FileCheck %s --check-prefix=ERR
# ERR: error: no memory region specified for section '.out.big'

#--- a.s
.text
.global _start
_start: ret

#--- b.s
.section .big,"a"
.byte 1

#--- a.t
MEMORY { ROM : ORIGIN = 0x100, LENGTH = 0x8000 }
SECTIONS {
  .text : { *(.text) } >ROM
  OVERLAY 0x1000 : AT (0x5000) {
    .out.big { *(.big) }
    .out.small { *(.small) }
  }
}
