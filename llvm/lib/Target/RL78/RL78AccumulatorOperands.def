//===----------------------------------------------------------------------===//
//
// The instruction descriptions give accumulator operands the general register
// classes (RL78RPRegs, RL78Reg); the custom inserters then pin them to $rp0
// (AX) or $r1 (A). This lists the operands they pin, for the allocator:
//
//   ACC_OPERAND(Opcode, OperandIndex, Class)   Class is AX or A
//
// and the accumulator operands that other registers may also fill:
//
//   ANY_OPERAND(Opcode, OperandIndex)
//
// Taken from the operands seen in $rp0/$r1 after instruction selection over
// the tickets corpus, CoreMark and Embench (-O2/-O3/-Os, S1/S2/S3; regenerate
// with llc -rl78-acc-census). Calls, branches and operands seen as both AX
// and A are left out. ANY_OPERAND lists only operands every register encodes
// (MOV r,#byte; MOVW rp,#word; ADDW AX,rp) or that
// RL78InsertExchangeInstructions fixes up (MOV r,ES:!addr16); CMP0 and CLRB,
// also seen in other registers, encode only X, A, C and B and are listed as A.
//
//===----------------------------------------------------------------------===//

#ifdef ACC_OPERAND
ACC_OPERAND(AND16_rp_imm, 0, AX)
ACC_OPERAND(AND16_rp_imm, 1, AX)
ACC_OPERAND(AND16_rp_rp, 0, AX)
ACC_OPERAND(AND16_rp_rp, 1, AX)
ACC_OPERAND(AND2_16_rp_rp, 0, AX)
ACC_OPERAND(AND2_16_rp_rp, 1, AX)
