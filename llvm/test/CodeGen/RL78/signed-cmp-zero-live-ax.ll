; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; `x > 0` on an int is CMPW AX, #0 + XOR1 CY, A.7, which
; RL78InsertExchangeInstructions shortens to ADDW AX, AX when AX is dead
; afterwards. XOR1 reads only A, so X (the low byte) must be dead as well.
; In f the low byte is still needed as the shift count; the allocator keeps
; the value in BC and compares a copy, which may then be doubled.
; RUN: llc -mtriple=rl78 -O3 < %s | FileCheck %s

@shift = global i16 1
@res = global i16 0

define void @f() {
; CHECK-LABEL: f:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw bc, !LOWW(_shift)
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    addw ax, ax
; CHECK-NEXT:    bnh $.LBB0_2
; CHECK-NEXT:  ; %bb.1: ; %then
; CHECK-NEXT:    movw de, #8
; CHECK-NEXT:    xch a, b
; CHECK-NEXT:    mov a, c
; CHECK-NEXT:    xch a, b
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    shl b, 5
; CHECK-NEXT:    sknc
; CHECK-NEXT:    shrw ax, 8
; CHECK-NEXT:    shl b, 1
; CHECK-NEXT:    sknc
; CHECK-NEXT:    shrw ax, 4
; CHECK-NEXT:    shl b, 1
; CHECK-NEXT:    sknc
; CHECK-NEXT:    shrw ax, 2
; CHECK-NEXT:    cmp0 b
; CHECK-NEXT:    skz
; CHECK-NEXT:    shrw ax, 1
; CHECK-NEXT:    movw !LOWW(_res), ax
; CHECK-NEXT:  .LBB0_2: ; %end
; CHECK-NEXT:    ret
  %s = load i16, ptr @shift
  %c = icmp sgt i16 %s, 0
  br i1 %c, label %then, label %end

then:
  %r = lshr i16 8, %s
  store i16 %r, ptr @res
  br label %end

end:
  ret void
}

; With AX dead after the compare the shorter form is still used.
define void @g() {
; CHECK-LABEL: g:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw bc, !LOWW(_shift)
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    addw ax, ax
; CHECK-NEXT:    bnh $.LBB1_2
; CHECK-NEXT:  ; %bb.1: ; %then
; CHECK-NEXT:    movw ax, #4
; CHECK-NEXT:    movw !LOWW(_res), ax
; CHECK-NEXT:  .LBB1_2: ; %end
; CHECK-NEXT:    ret
  %s = load i16, ptr @shift
  %c = icmp sgt i16 %s, 0
  br i1 %c, label %then, label %end

then:
  store i16 4, ptr @res
  br label %end

end:
  ret void
}
