; flags.

declare void @g()

define void @br_uge(i64 %a, i64 %b) optsize {
; CHECK-LABEL: br_uge:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    call !_OUTLINED_FUNCTION_1
; CHECK-NEXT:    call !_OUTLINED_FUNCTION_0
; CHECK-NEXT:    skc
; CHECK-NEXT:  ; %bb.1: ; %call
; CHECK-NEXT:    call !_g
; CHECK-NEXT:  .LBB0_2: ; %end
; CHECK-NEXT:    ret
entry:
  %c = icmp uge i64 %a, %b
  br i1 %c, label %call, label %end

call:
  call void @g()
  br label %end

end:
  ret void
}

