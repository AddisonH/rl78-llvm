; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; Loop strength reduction counts instructions first on RL78: two pointers
; that step together stay two pointers. One index for both would save an
; induction variable and cost an addition per access, as there is no
; register + register address.
; RUN: llc -verify-machineinstrs -mtriple=rl78 -O2 < %s | FileCheck %s

define ptr @copy(ptr returned %d, ptr %s) {
; CHECK-LABEL: copy:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    push bc
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    push bc
; CHECK-NEXT:    pop de
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mov a, [hl]
; CHECK-NEXT:    mov [de], a
; CHECK-NEXT:    incw de
; CHECK-NEXT:    incw hl
; CHECK-NEXT:    cmp0 a
; CHECK-NEXT:    bnz $.LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    ret
entry:
  br label %loop

loop:
  %sp = phi ptr [ %s, %entry ], [ %sp.next, %loop ]
  %dp = phi ptr [ %d, %entry ], [ %dp.next, %loop ]
  %sp.next = getelementptr inbounds i8, ptr %sp, i16 1
  %c = load i8, ptr %sp, align 1
  %dp.next = getelementptr inbounds i8, ptr %dp, i16 1
  store i8 %c, ptr %dp, align 1
  %z = icmp eq i8 %c, 0
  br i1 %z, label %exit, label %loop

exit:
  ret ptr %d
}
