; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mattr=+far-code -verify-machineinstrs -mtriple=rl78 -O2 < %s | FileCheck %s

; With -mfar-code a function address is 32 bits. Inline asm takes symbols and constants ("X", "i", "n", printed with the
; generic modifiers) and "r" operands wider than a register pair, in several
; pairs (%0 names the first).

target datalayout = "e-m:o-p0:16:16:16-p1:16:16:16-p2:32:16:16:16-p3:32:16:16:16-i32:16-i64:16-f32:16-f64:16-a:8-n8:8-n16:16-S16-P3"

@x = global i16 0, align 2
@y = addrspace(2) global i16 0, align 2

declare void @f() addrspace(3)

define void @imm() {
; CHECK-LABEL: imm:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    ; _f 5 _x _y
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    ret
  call void asm sideeffect "; ${0:c} $1 ${2:c} ${3:c}", "X,n,i,i"(ptr addrspace(3) @f, i16 5, ptr @x, ptr addrspace(2) @y)
  ret void
}

define i32 @wide(i32 %a) {
; CHECK-LABEL: wide:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    ; ax
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    ret
  %r = call i32 asm sideeffect "; $0", "=r,0"(i32 %a)
  ret i32 %r
}

define ptr addrspace(3) @fptr(ptr addrspace(3) %p) {
; CHECK-LABEL: fptr:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    shrw ax, 8
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    ; de
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    mov a, x
; CHECK-NEXT:    ret
  %r = call ptr addrspace(3) asm sideeffect "; $0", "=r,0"(ptr addrspace(3) %p)
  ret ptr addrspace(3) %r
}
