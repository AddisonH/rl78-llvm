; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw de, #0
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    subw ax, hl
; CHECK-NEXT:    movw [sp+0], ax ; 2-byte Folded Spill
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    subc a, c
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    subc a, b
; CHECK-NEXT:    movw de, ax
; CHECK-NEXT:    mov a, b
; CHECK-NEXT:    bt a.7, $.LBB2_1
; CHECK-NEXT:  ; %bb.2:
; CHECK-NEXT:    movw ax, hl
; CHECK-NEXT:    push bc
; CHECK-NEXT:    pop de
; CHECK-NEXT:    br $.LBB2_3
; CHECK-NEXT:  .LBB2_1:
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:  .LBB2_3:
; CHECK-NEXT:    push de
; CHECK-NEXT:    pop bc
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    ret
  %r = call i32 @llvm.abs.i32(i32 %a, i1 false)
  ret i32 %r
}

; A 16-bit comparison.
define i32 @sel16(i16 %c, i32 %a, i32 %b) optsize {
; CHECK-LABEL: sel16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    cmpw ax, #7
; CHECK-NEXT:    bc $.LBB3_2
; CHECK-NEXT:  ; %bb.1: ; %select.false
; CHECK-NEXT:    movw ax, [sp+6]
; CHECK-NEXT:    movw de, ax
; CHECK-NEXT:    movw ax, [sp+4]
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:  .LBB3_2: ; %select.end
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    push de
; CHECK-NEXT:    pop bc
; CHECK-NEXT:    ret
  %z = icmp ult i16 %c, 7
  %r = select i1 %z, i32 %a, i32 %b
  ret i32 %r
