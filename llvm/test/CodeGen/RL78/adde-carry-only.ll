; RUN: llc -mtriple=rl78 -O2 < %s | FileCheck %s

; Incrementing an i32 in memory: the high half only takes the carry. It is
; loaded into a register and incremented with a skip, not added byte by byte
; through A with ADDC from memory.

define void @inc(ptr %c, i16 %i) {
; CHECK-LABEL: inc:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    shlw bc, 2
; CHECK-NEXT:    addw ax, bc
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw ax, [hl+2]
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    onew ax
; CHECK-NEXT:    addw ax, [hl+0]
; CHECK-NEXT:    sknc
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    incw bc
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    movw [hl], ax
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    movw [hl+2], ax
; CHECK-NEXT:    ret
  %p = getelementptr inbounds i32, ptr %c, i16 %i
  %v = load i32, ptr %p, align 2
  %n = add i32 %v, 1
  store i32 %n, ptr %p, align 2
  ret void
}

define void @dec(ptr %c) {
; CHECK-LABEL: dec:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw ax, [hl+2]
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    movw ax, #-3
; CHECK-NEXT:    addw ax, [hl+0]
; CHECK-NEXT:    skc
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    decw bc
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    movw [hl], ax
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    movw [hl+2], ax
; CHECK-NEXT:    ret
  %v = load i32, ptr %c, align 2
  %n = add i32 %v, -3
  store i32 %n, ptr %c, align 2
  ret void
}
