; CHECK-NEXT:    movw de, ax
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    push de
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    addw ax, [hl+0]
; CHECK-NEXT:    movw [de], ax
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    addc a, [hl+2]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    addc a, [hl+3]
; CHECK-NEXT:    movw [de+2], ax
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    ret
  %a = load i32, ptr %p
  %c = add i32 %a, %x
  store i32 %c, ptr %p
  ret void
}

; Not when the result may overlap an operand that is still to be read.
define void @overlap(ptr %r, ptr %a, ptr %b) {
; CHECK-LABEL: overlap:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push ax
; CHECK-NEXT:    push de
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    push bc
; CHECK-NEXT:    pop de
; CHECK-NEXT:    movw ax, [de]
; CHECK-NEXT:    addw ax, [hl+0]
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    movw ax, [de+2]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    addc a, [hl+2]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    addc a, [hl+3]
; CHECK-NEXT:    xchw ax, hl
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:    xchw ax, hl
