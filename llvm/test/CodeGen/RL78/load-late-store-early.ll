; RUN: llc -mtriple=rl78 -mcpu=RL78_S3 -O2 -verify-machineinstrs < %s | FileCheck %s

@g = global i32 0
@h = global i32 0

; Each word is stored when it has been added, and the next one is loaded
; after that: neither changes the carry.
define void @add() {
; CHECK-LABEL: add:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw ax, !LOWW(_g)
; CHECK-NEXT:    addw ax, !LOWW(_h)
; CHECK-NEXT:    movw !LOWW(_g), ax
; CHECK-NEXT:    movw ax, !LOWW(_g+2)
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    addc a, !LOWW(_h+2)
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    addc a, !LOWW(_h+3)
; CHECK-NEXT:    movw !LOWW(_g+2), ax
; CHECK-NEXT:    ret
  %a = load i32, ptr @g
  %b = load i32, ptr @h
  %c = add i32 %a, %b
  store i32 %c, ptr @g
  ret void
}

; Also from under the branch that adds the carry to the high word.
define void @increment() {
; CHECK-LABEL: increment:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw bc, !LOWW(_g+2)
; CHECK-NEXT:    onew ax
; CHECK-NEXT:    addw ax, !LOWW(_g)
; CHECK-NEXT:    movw !LOWW(_g), ax
; CHECK-NEXT:    sknc
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    incw bc
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    movw !LOWW(_g+2), ax
; CHECK-NEXT:    ret
  %a = load i32, ptr @g
  %c = add i32 %a, 1
  store i32 %c, ptr @g
  ret void
}

; The low word may be stored before the high word of the same value is read.
define void @in_place(ptr %p, i32 %x) {
; CHECK-LABEL: in_place:
