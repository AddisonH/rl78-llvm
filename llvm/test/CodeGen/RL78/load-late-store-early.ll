; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    movw [hl], ax
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    ret
  %x = load i32, ptr %a
  %y = load i32, ptr %b
  %c = add i32 %x, %y
  store i32 %c, ptr %r
  ret void
}

