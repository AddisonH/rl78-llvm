; The leading zeros of a word are counted by a loop that shifts it to the
; left until a bit comes out; a one behind the word ends it for zero.

define i16 @ctlz16(i16 %x) {
; CHECK-LABEL: ctlz16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    mov d, #0
; CHECK-NEXT:    addw ax, bc
; CHECK-NEXT:    mov e, #0
; CHECK-NEXT:    bc $.LBB0_3
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    incw ax
; CHECK-NEXT:  .LBB0_2: ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    inc e
; CHECK-NEXT:    addw ax, ax
; CHECK-NEXT:    bnc $.LBB0_2
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    ret
  %r = call i16 @llvm.ctlz.i16(i16 %x, i1 false)
  ret i16 %r
}

