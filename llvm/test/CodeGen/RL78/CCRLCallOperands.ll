; CHECK-NEXT:    movw [sp+2], ax
; CHECK-NEXT:    movw ax, #513
; CHECK-NEXT:    movw [sp+0], ax
; CHECK-NEXT:    mov [sp+4], #5
; CHECK-NEXT:    call !_callee_struct5
; CHECK-NEXT:    addw sp, #6
; CHECK-NEXT:    ret
  tail call void @callee_struct5([5 x i8] c"\01\02\03\04\05")
