; CHECK-NEXT:    movw ax, hl
; CHECK-NEXT:    movw [sp+4], ax ; 2-byte Folded Spill
; CHECK-NEXT:    clrw ax
; CHECK-NEXT:    movw [sp+0], ax ; 2-byte Folded Spill
; CHECK-NEXT:    decw de
; CHECK-NEXT:    inc d
; CHECK-NEXT:    inc e
; CHECK-NEXT:    push de
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    xch a, e
; CHECK-NEXT:    mov [sp+2], a ; 1-byte Folded Spill
; CHECK-NEXT:    xch a, e
; CHECK-NEXT:    push bc
; CHECK-NEXT:    pop de
; CHECK-NEXT:    xch a, l
; CHECK-NEXT:    mov a, h
; CHECK-NEXT:    mov [sp+3], a ; 1-byte Folded Spill
; CHECK-NEXT:    xch a, l
; CHECK-NEXT:    xchw ax, hl
; CHECK-NEXT:    movw ax, [sp+4] ; 2-byte Folded Reload
; CHECK-NEXT:    xchw ax, hl
; CHECK-NEXT:  .LBB0_3: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    movw !0xffff0, ax
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:    movw !0xffff2, ax
; CHECK-NEXT:    movw ax, [hl]
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    movw ax, [de]
; CHECK-NEXT:    mach
; CHECK-NEXT:    movw ax, !0xffff2
; CHECK-NEXT:    movw [sp+0], ax ; 2-byte Folded Spill
; CHECK-NEXT:    movw ax, !0xffff0
; CHECK-NEXT:    incw hl
; CHECK-NEXT:    incw hl
; CHECK-NEXT:    incw de
; CHECK-NEXT:    incw de
; CHECK-NEXT:    xch a, c
; CHECK-NEXT:    mov a, [sp+2] ; 1-byte Folded Reload
; CHECK-NEXT:    xch a, c
; CHECK-NEXT:    dec c
; CHECK-NEXT:    xch a, c
; CHECK-NEXT:    mov [sp+2], a ; 1-byte Folded Spill
; CHECK-NEXT:    xch a, c
; CHECK-NEXT:    cmp0 c
; CHECK-NEXT:    bnz $.LBB0_3
; CHECK-NEXT:  ; %bb.4: ; %loop.hi
; CHECK-NEXT:    ; in Loop: Header=BB0_3 Depth=1
; CHECK-NEXT:    xch a, c
; CHECK-NEXT:    mov a, [sp+3] ; 1-byte Folded Reload
; CHECK-NEXT:    xch a, c
; CHECK-NEXT:    dec c
; CHECK-NEXT:    xch a, c
; CHECK-NEXT:    mov [sp+3], a ; 1-byte Folded Spill
; CHECK-NEXT:    xch a, c
; CHECK-NEXT:    cmp0 c
; CHECK-NEXT:    bnz $.LBB0_3
; CHECK-NEXT:    br $.LBB0_5
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    clrw ax
; CHECK-NEXT:    movw [sp+0], ax ; 2-byte Folded Spill
; CHECK-NEXT:  .LBB0_5: ; %exit
; CHECK-NEXT:    xchw ax, bc
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:    xchw ax, bc
; CHECK-NEXT:    addw sp, #6
; CHECK-NEXT:    ret
entry:
  %z = icmp eq i16 %n, 0
  br i1 %z, label %exit, label %loop

loop:
  %i = phi i16 [ %i.next, %loop ], [ 0, %entry ]
  %s = phi i32 [ %s.next, %loop ], [ 0, %entry ]
  %pa = getelementptr inbounds i16, ptr %a, i16 %i
  %va = load i16, ptr %pa, align 2
  %xa = sext i16 %va to i32
  %pb = getelementptr inbounds i16, ptr %b, i16 %i
  %vb = load i16, ptr %pb, align 2
  %xb = sext i16 %vb to i32
  %m = mul nsw i32 %xb, %xa
  %s.next = add nsw i32 %m, %s
  %i.next = add nuw i16 %i, 1
  %c = icmp eq i16 %i.next, %n
  br i1 %c, label %exit, label %loop

exit:
  %r = phi i32 [ 0, %entry ], [ %s.next, %loop ]
  ret i32 %r
}

