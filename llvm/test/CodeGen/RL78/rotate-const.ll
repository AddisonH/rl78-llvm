; CHECK-NEXT:    mov1 cy, a.7
; CHECK-NEXT:    rolwc ax, 1
; CHECK-NEXT:    ret
  %r = call i16 @llvm.fshl.i16(i16 %a, i16 %a, i16 1)
  ret i16 %r
}

