; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; 16-bit AND/OR/XOR stay one pseudo on AX until after allocation, where they
; become a byte at a time through A and XCH A, X.
; RUN: llc -mtriple=rl78 -O2 < %s | FileCheck %s

@g = global i16 0

; The Z flag the expansion leaves is that of the low byte only, so the
; compare with 0 must stay (the pseudo does not define Zflag).
define void @and_eq0(i16 %x, i16 %y) {
; CHECK-LABEL: and_eq0:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    and a, b
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    and a, c
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    cmpw ax, #0
; CHECK-NEXT:    skz
; CHECK-NEXT:  ; %bb.2: ; %e
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_1: ; %t
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    movw !LOWW(_g), ax
; CHECK-NEXT:    ret
  %a = and i16 %x, %y
  %c = icmp eq i16 %a, 0
  br i1 %c, label %t, label %e
t:
  store i16 %a, ptr @g
  ret void
e:
  ret void
}

define i16 @or_imm(i16 %x) {
; CHECK-LABEL: or_imm:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    or a, #52
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    or a, #18
; CHECK-NEXT:    ret
  %r = or i16 %x, 4660
  ret i16 %r
}
