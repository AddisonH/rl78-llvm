; A 32-bit value against zero: its bytes are ORed into A.
define i16 @zero32(i32 %x, i16 %a, i16 %b) {
; CHECK-LABEL: zero32:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    or a, x
; CHECK-NEXT:    or a, c
; CHECK-NEXT:    or a, b
; CHECK-NEXT:    bz $.LBB0_2
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    movw ax, [sp+4]
; CHECK-NEXT:    movw de, ax
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    ret
  %c = icmp eq i32 %x, 0
  %r = select i1 %c, i16 %a, i16 %b
  ret i16 %r
}

; The low bits of a word and a field of it are two shifts.
define i16 @low3(i16 %x) {
; CHECK-LABEL: low3:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    shlw ax, 13
; CHECK-NEXT:    shrw ax, 13
; CHECK-NEXT:    ret
  %r = and i16 %x, 7
  ret i16 %r
}

define i16 @field(i16 %x) {
; CHECK-LABEL: field:
