; A counter that only counts is kept in byte registers and counted down with
; DEC, which sets Z: RL78ByteLoopCounters, and the DEC is moved down to the
; branch (RL78CMPWithZeroElimination).
; RUN: llc -verify-machineinstrs -mtriple=rl78 -O2 < %s | FileCheck %s
; RUN: llc -verify-machineinstrs -mtriple=rl78 -O2 -rl78-byte-counters=false < %s | FileCheck %s --check-prefix=WORD

; The number of iterations is not known: two bytes, the high one counted
; once in 256 iterations.
define i16 @sum(ptr %p, i16 %n) {
; CHECK-LABEL: sum:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    or a, x
; CHECK-NEXT:    bz $.LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %loop.preheader
; CHECK-NEXT:    decw bc
; CHECK-NEXT:    inc b
; CHECK-NEXT:    inc c
; CHECK-NEXT:    clrw ax
; CHECK-NEXT:  .LBB0_3: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    addw ax, [hl+0]
; CHECK-NEXT:    incw hl
; CHECK-NEXT:    incw hl
; CHECK-NEXT:    dec c
; CHECK-NEXT:    bnz $.LBB0_3
; CHECK-NEXT:  ; %bb.4: ; %loop.hi
; CHECK-NEXT:    ; in Loop: Header=BB0_3 Depth=1
; CHECK-NEXT:    dec b
; CHECK-NEXT:    bnz $.LBB0_3
; CHECK-NEXT:  ; %bb.5: ; %exit
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    clrw ax
; CHECK-NEXT:    ret
;
; WORD-LABEL: sum:
; WORD:       ; %bb.0: ; %entry
; WORD-NEXT:    movw hl, ax
; WORD-NEXT:    movw ax, bc
; WORD-NEXT:    or a, x
; WORD-NEXT:    bz $.LBB0_1
; WORD-NEXT:  ; %bb.2: ; %loop.preheader
; WORD-NEXT:    clrw ax
; WORD-NEXT:  .LBB0_3: ; %loop
; WORD-NEXT:    ; =>This Inner Loop Header: Depth=1
; WORD-NEXT:    decw bc
; WORD-NEXT:    addw ax, [hl+0]
; WORD-NEXT:    incw hl
; WORD-NEXT:    incw hl
; WORD-NEXT:    movw de, ax
; WORD-NEXT:    movw ax, bc
; WORD-NEXT:    or a, x
; WORD-NEXT:    movw ax, de
; WORD-NEXT:    bnz $.LBB0_3
; WORD-NEXT:  ; %bb.4: ; %exit
; WORD-NEXT:    movw ax, de
; WORD-NEXT:    ret
; WORD-NEXT:  .LBB0_1:
; WORD-NEXT:    movw de, #0
; WORD-NEXT:    movw ax, de
; WORD-NEXT:    ret
entry:
  %z = icmp eq i16 %n, 0
  br i1 %z, label %exit, label %loop

loop:
  %i = phi i16 [ %i.next, %loop ], [ %n, %entry ]
  %s = phi i16 [ %s.next, %loop ], [ 0, %entry ]
  %q = phi ptr [ %q.next, %loop ], [ %p, %entry ]
  %v = load i16, ptr %q, align 2
  %s.next = add i16 %s, %v
  %q.next = getelementptr i8, ptr %q, i16 2
  %i.next = add i16 %i, -1
  %c = icmp eq i16 %i.next, 0
  br i1 %c, label %exit, label %loop

exit:
  %r = phi i16 [ 0, %entry ], [ %s.next, %loop ]
  ret i16 %r
}

