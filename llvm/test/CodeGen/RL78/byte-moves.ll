; The word in the middle of two, (a >> 8) + (b << 8), is two byte moves with
; either value in AX: MOV X, A; MOV A, r or MOV A, r; XCH A, X. Shifts and
; rotates of 32-bit values by 8 are made of it.

define i16 @middle(i16 %a, i16 %b) {
; CHECK-LABEL: middle:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov x, a
; CHECK-NEXT:    mov a, c
; CHECK-NEXT:    ret
  %lo = lshr i16 %a, 8
  %hi = shl i16 %b, 8
  %r = or i16 %lo, %hi
  ret i16 %r
}

define i16 @middle_other(i16 %b, i16 %a) {
; CHECK-LABEL: middle_other:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    mov a, b
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    ret
  %lo = lshr i16 %a, 8
  %hi = shl i16 %b, 8
  %r = or i16 %lo, %hi
  ret i16 %r
}

