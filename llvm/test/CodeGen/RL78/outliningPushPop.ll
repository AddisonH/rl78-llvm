; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=rl78 < %s | FileCheck %s

target datalayout = "e-m:o-p0:16:16:16-p1:16:16:16-p2:32:16:16:16-p3:32:16:16:16-i32:16-i64:16-f32:16-f64:16-a:8-n8:8-n16:16-S16"
target triple = "rl78-unknown-unknown-elf"

; Instructions "push"/"pop" are illegal to outline, no _OUTLINED_FUNCTION_0 should be present in assembly file.
define dso_local i16 @test_pushPop_1(i16 noundef %x) {
; CHECK-LABEL: test_pushPop_1:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push ax
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    incw bc
; CHECK-NEXT:    movw [sp+0], ax
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    ret
  %x.addr = alloca i16, align 2
  store i16 %x, ptr %x.addr, align 2
  %1 = load i16, ptr %x.addr, align 2
  %add = add nsw i16 %1, 1
  ret i16 %add
}

define dso_local i16 @test_pushPop_2(i16 noundef %x) {
; CHECK-LABEL: test_pushPop_2:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push ax
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    incw bc
; CHECK-NEXT:    movw [sp+0], ax
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    ret
  %x.addr = alloca i16, align 2
  store i16 %x, ptr %x.addr, align 2
  %1 = load i16, ptr %x.addr, align 2
  %add = add nsw i16 %1, 1
  ret i16 %add
}
