; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -verify-machineinstrs -mtriple=rl78 -O2 -rl78-select-to-branch=false < %s | FileCheck %s

; An ordered i32 compare producing a value compares the high halves (signed:
; with the XOR1 fixup), then on equality the low halves into the same flags,
; and selects once: one CMPW per half and a single conditional branch.

define i16 @sgt(i32 %a, i32 %b) {
; CHECK-LABEL: sgt:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw de, ax
; CHECK-NEXT:    movw hl, sp
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    cmpw ax, [hl+6]
; CHECK-NEXT:    xor1 cy, a.7
; CHECK-NEXT:    mov a, [sp+7]
; CHECK-NEXT:    xor1 cy, a.7
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    sknz
; CHECK-NEXT:    cmpw ax, [hl+4]
; CHECK-NEXT:    bh $.LBB0_1
; CHECK-NEXT:  ; %bb.2:
; CHECK-NEXT:    clrw ax
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    onew ax
; CHECK-NEXT:    ret
  %c = icmp sgt i32 %a, %b
  %z = zext i1 %c to i16
  ret i16 %z
}

define i16 @ule(i32 %a, i32 %b) {
; CHECK-LABEL: ule:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw de, ax
; CHECK-NEXT:    movw hl, sp
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    cmpw ax, [hl+6]
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    sknz
; CHECK-NEXT:    cmpw ax, [hl+4]
; CHECK-NEXT:    bnh $.LBB1_1
; CHECK-NEXT:  ; %bb.2:
; CHECK-NEXT:    clrw ax
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB1_1:
; CHECK-NEXT:    onew ax
; CHECK-NEXT:    ret
  %c = icmp ule i32 %a, %b
  %z = zext i1 %c to i16
  ret i16 %z
}

define i16 @sel(i32 %a, i32 %b, i16 %x, i16 %y) {
; CHECK-LABEL: sel:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push de
; CHECK-NEXT:    movw de, ax
; CHECK-NEXT:    movw hl, sp
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    cmpw ax, [hl+8]
; CHECK-NEXT:    xor1 cy, a.7
; CHECK-NEXT:    mov a, [sp+9]
; CHECK-NEXT:    xor1 cy, a.7
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    sknz
; CHECK-NEXT:    cmpw ax, [hl+6]
; CHECK-NEXT:    bc $.LBB2_2
; CHECK-NEXT:  ; %bb.1:
; CHECK-NEXT:    movw ax, [sp+10]
; CHECK-NEXT:    movw [sp+0], ax ; 2-byte Folded Spill
; CHECK-NEXT:  .LBB2_2:
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    ret
  %c = icmp slt i32 %a, %b
  %s = select i1 %c, i16 %x, i16 %y
  ret i16 %s
}
