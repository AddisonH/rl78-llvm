; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; A word at base + zero-extended byte: [HL+B] and [HL+C] address bytes only,
; so the sum is computed and used as a base register. The load and the store
; could not be selected.
; RUN: llc -verify-machineinstrs -mtriple=rl78 < %s | FileCheck %s

define i16 @load_word(ptr %p, i8 %c) {
; CHECK-LABEL: load_word:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    clrb b
; CHECK-NEXT:    addw ax, bc
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw ax, [hl]
; CHECK-NEXT:    ret
  %i = zext i8 %c to i16
  %a = getelementptr inbounds nuw i8, ptr %p, i16 %i
  %v = load i16, ptr %a, align 2
  ret i16 %v
}

define void @store_word(ptr %p, i8 %c, i16 %v) {
; CHECK-LABEL: store_word:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    clrb b
; CHECK-NEXT:    addw ax, bc
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    movw [hl], ax
; CHECK-NEXT:    ret
  %i = zext i8 %c to i16
  %a = getelementptr inbounds nuw i8, ptr %p, i16 %i
  store i16 %v, ptr %a, align 2
  ret void
}

define i16 @load_word_disp(ptr %p, i8 %c) {
; CHECK-LABEL: load_word_disp:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    clrb b
; CHECK-NEXT:    addw ax, bc
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw ax, [hl+4]
; CHECK-NEXT:    ret
  %i = zext i8 %c to i16
  %a = getelementptr inbounds nuw i8, ptr %p, i16 %i
  %b = getelementptr inbounds nuw i8, ptr %a, i16 4
  %v = load i16, ptr %b, align 2
