; RUN: llc -mtriple=rl78 -O2 -verify-machineinstrs < %s | FileCheck %s

; The value of a commutative operation that is in AX already stays there.
define i16 @and16(i16 %x, i16 %y) {
; CHECK-LABEL: and16:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    and a, b
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    and a, c
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    ret
  %r = and i16 %x, %y
  ret i16 %r
}

define i8 @xor8(i8 %x, i8 %y) {
; CHECK-LABEL: xor8:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xor a, x
; CHECK-NEXT:    ret
  %r = xor i8 %y, %x
  ret i8 %r
}

; AX changes places with BC around the shift instead of waiting in DE.
define i32 @shr32(i32 %x) {
; CHECK-LABEL: shr32:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xchw ax, bc
; CHECK-NEXT:    shrw ax, 1
; CHECK-NEXT:    xchw ax, bc
; CHECK-NEXT:    rorc a, 1
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    rorc a, 1
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    ret
  %r = lshr i32 %x, 1
  ret i32 %r
}

; Not when the register that keeps the value of AX is read in between.
define i32 @keep(i16 %x, i16 %y) {
; CHECK-LABEL: keep:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    shrw ax, 3
; CHECK-NEXT:    xor a, h
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    xor a, l
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    movw ax, hl
; CHECK-NEXT:    ret
  %a = lshr i16 %y, 3
  %b = xor i16 %a, %x
  %lo = zext i16 %x to i32
  %hi = zext i16 %b to i32
  %s = shl i32 %hi, 16
  %r = or i32 %s, %lo
  ret i32 %r
}
