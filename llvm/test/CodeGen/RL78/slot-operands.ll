; A copy to the accumulator becomes the load.
define i16 @copy(i16 %a, i16 %b, i16 %c, i16 %d, i16 %e, ptr %p) {
; CHECK-LABEL: copy:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xchw ax, hl
; CHECK-NEXT:    movw ax, [sp+8]
; CHECK-NEXT:    xchw ax, hl
; CHECK-NEXT:    movw [hl], ax
; CHECK-NEXT:    movw ax, [sp+6]
; CHECK-NEXT:    movw hl, sp
; CHECK-NEXT:    addw ax, #5
; CHECK-NEXT:    xor a, [hl+7]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    xor a, [hl+6]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    ret
;
; RELOAD-LABEL: copy:
; RELOAD:       ; %bb.0:
; RELOAD-NEXT:    xchw ax, hl
; RELOAD-NEXT:    movw ax, [sp+8]
; RELOAD-NEXT:    xchw ax, hl
; RELOAD-NEXT:    movw [hl], ax
; RELOAD-NEXT:    movw ax, [sp+6]
; RELOAD-NEXT:    movw hl, ax
; RELOAD-NEXT:    addw ax, #5
; RELOAD-NEXT:    xor a, h
; RELOAD-NEXT:    xch a, x
; RELOAD-NEXT:    xor a, l
; RELOAD-NEXT:    xch a, x
; RELOAD-NEXT:    ret
  store i16 %a, ptr %p
  %s = add i16 %e, 5
  %x = xor i16 %s, %e
  ret i16 %x
}

