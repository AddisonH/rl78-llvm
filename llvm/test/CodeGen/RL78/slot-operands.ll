; Two arguments from the stack, one of them used twice; the XOR reads its
; bytes.
define i16 @word(i16 %a, i16 %b, i16 %c, i16 %d, i16 %e, i16 %f) {
; CHECK-LABEL: word:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw hl, sp
; CHECK-NEXT:    subw ax, [hl+6]
; CHECK-NEXT:    addw ax, [hl+8]
; CHECK-NEXT:    xor a, [hl+7]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    xor a, [hl+6]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    ret
;
; RELOAD-LABEL: word:
; RELOAD:       ; %bb.0:
; RELOAD-NEXT:    xchw ax, hl
; RELOAD-NEXT:    movw ax, [sp+6]
; RELOAD-NEXT:    xchw ax, hl
; RELOAD-NEXT:    xchw ax, bc
; RELOAD-NEXT:    movw ax, [sp+8]
; RELOAD-NEXT:    xchw ax, bc
; RELOAD-NEXT:    subw ax, hl
; RELOAD-NEXT:    addw ax, bc
; RELOAD-NEXT:    xor a, h
; RELOAD-NEXT:    xch a, x
; RELOAD-NEXT:    xor a, l
; RELOAD-NEXT:    xch a, x
; RELOAD-NEXT:    ret
  %s = sub i16 %a, %e
  %t = add i16 %s, %f
  %x = xor i16 %t, %e
  ret i16 %x
}

