; Test for replacing the BT saddr.bit + CLR1 saddr.bit with a BTCLR.
; FIXME: The BTCLR is not formed: RL78SelectBTCLR only removes the clear from
; a block that the branch alone enters, and here the fall-through path of the
; same branch enters it too (the bit is known clear there).
; RUN: llc -verify-machineinstrs -mtriple=rl78 < %s | FileCheck %s

@x = global i16 0
@y = global i8 0 #0

define void @faux() {
; CHECK-LABEL: faux:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    ret
  ret void
}

define void @test()  {
; CHECK-LABEL: test:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    bt _y.0, $.LBB1_2
; CHECK-NEXT:  ; %bb.1: ; %if.then
; CHECK-NEXT:    incw !LOWW(_x)
; CHECK-NEXT:  .LBB1_2: ; %if.end
; CHECK-NEXT:    clr1 _y.0
; CHECK-NEXT:    ret
entry:
  %0 = load volatile i8, ptr @y
  %1 = and i8 %0, 1
  %cmp = icmp eq i8 %1, 0
  br i1 %cmp, label %if.then, label %if.end

if.then:
  %2 = load i16, ptr @x, align 2
  %inc.i = add nsw i16 %2, 1
  store i16 %inc.i, ptr @x, align 2
  br label %if.end

if.end:
  %3 = load volatile i8, ptr @y
  %4 = and i8 %3, -2
  store volatile i8 %4, ptr @y
  ret void
}

attributes #0 = { "saddr" }


