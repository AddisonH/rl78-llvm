; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -verify-machineinstrs -mtriple=rl78 -addr-sink-using-gep=false < %s | FileCheck %s

; A negative constant offset from a far pointer (sunk by CodeGenPrepare as an
; integer add, as the driver's -addr-sink-using-gep=false does) is added to
; the low 16 bits only. It reached SelectionDAG::getConstant as a 32-bit
; two's complement value and asserted (newlib _realloc_r built with far data pointers).

define ptr addrspace(2) @negofs(ptr addrspace(2) %p) {
; CHECK-LABEL: negofs:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    decw de
; CHECK-NEXT:    decw de
; CHECK-NEXT:    mov es, a
; CHECK-NEXT:    movw ax, es:[de]
; CHECK-NEXT:    or a, x
; CHECK-NEXT:    bz $.LBB0_2
; CHECK-NEXT:  ; %bb.1: ; %clear
; CHECK-NEXT:    clrw ax
; CHECK-NEXT:    movw es:[de], ax
; CHECK-NEXT:  .LBB0_2: ; %ret
; CHECK-NEXT:    movw de, #0
; CHECK-NEXT:    clrb a
; CHECK-NEXT:    ret
entry:
  %size = getelementptr i8, ptr addrspace(2) %p, i16 -2
  %v = load i16, ptr addrspace(2) %size, align 2
  %z = icmp eq i16 %v, 0
  br i1 %z, label %ret, label %clear

clear:
  store i16 0, ptr addrspace(2) %size, align 2
  br label %ret

ret:
  ret ptr addrspace(2) null
}
