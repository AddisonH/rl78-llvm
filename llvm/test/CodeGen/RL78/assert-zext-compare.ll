; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=rl78 -O2 -verify-machineinstrs < %s | FileCheck %s

; The range of a call's result is asserted with the number of bits it needs.
; Only an assertion of eight bits or fewer lets a comparison with zero look
; at the low byte alone.

declare range(i16 0, 32768) i16 @fifteen()
declare range(i16 0, 256) i16 @eight()

define i16 @wide() {
; CHECK-LABEL: wide:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    call !_fifteen
; CHECK-NEXT:    or a, x
; CHECK-NEXT:    bz $.LBB0_1
; CHECK-NEXT:  ; %bb.2:
; CHECK-NEXT:    movw ax, #5
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    movw ax, #3
; CHECK-NEXT:    ret
  %r = call i16 @fifteen()
  %c = icmp eq i16 %r, 0
  %s = select i1 %c, i16 3, i16 5
  ret i16 %s
}

define i16 @byte() {
; CHECK-LABEL: byte:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    call !_eight
; CHECK-NEXT:    mov a, x
; CHECK-NEXT:    cmp0 a
; CHECK-NEXT:    bz $.LBB1_1
; CHECK-NEXT:  ; %bb.2:
; CHECK-NEXT:    movw ax, #5
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB1_1:
; CHECK-NEXT:    movw ax, #3
; CHECK-NEXT:    ret
  %r = call i16 @eight()
  %c = icmp eq i16 %r, 0
  %s = select i1 %c, i16 3, i16 5
  ret i16 %s
}
