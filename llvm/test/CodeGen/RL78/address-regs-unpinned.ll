; RUN: llc -mtriple=rl78 -O2 < %s | FileCheck %s
; RUN: llc -mtriple=rl78 -O2 < %s \
; RUN:   | FileCheck %s --check-prefix=PINNED

; A list walk: the node pointer is loaded (p = p->next), carried around the
; loop, and is the base of both loads. Such loaded pointers are left to the
; register allocator (BC, DE or HL), so the pointer is not copied into a fixed
; pair (push/pop) each time round, as it was when every base was pinned to
; HL/DE before allocation. (Other bases keep the pin: unpinned, the allocator
; spilled worse around arithmetic pointers, Embench huffbench +18%.)



%node = type { ptr, i16 }

define ptr @find(ptr %n, i16 %key) {
; CHECK-LABEL: find:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw de, #0
; CHECK-NEXT:    cmpw ax, #0
; CHECK-NEXT:    bz $.LBB0_4
; CHECK-NEXT:  .LBB0_2: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    cmpw ax, [hl+2]
; CHECK-NEXT:    bz $.LBB0_3
; CHECK-NEXT:  ; %bb.5: ; %cont
; CHECK-NEXT:    ; in Loop: Header=BB0_2 Depth=1
; CHECK-NEXT:    movw ax, [hl]
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    cmpw ax, #0
; CHECK-NEXT:    bnz $.LBB0_2
; CHECK-NEXT:  .LBB0_4: ; %done
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    push hl
; CHECK-NEXT:    pop de
; CHECK-NEXT:    movw ax, de
; CHECK-NEXT:    ret
;
; PINNED-LABEL: find:
; PINNED:       ; %bb.0: ; %entry
; PINNED-NEXT:    movw hl, ax
; PINNED-NEXT:    movw de, #0
; PINNED-NEXT:    cmpw ax, #0
; PINNED-NEXT:    bz $.LBB0_4
; PINNED-NEXT:  .LBB0_2: ; %loop
; PINNED-NEXT:    ; =>This Inner Loop Header: Depth=1
; PINNED-NEXT:    movw ax, bc
; PINNED-NEXT:    cmpw ax, [hl+2]
; PINNED-NEXT:    bz $.LBB0_3
; PINNED-NEXT:  ; %bb.5: ; %cont
; PINNED-NEXT:    ; in Loop: Header=BB0_2 Depth=1
; PINNED-NEXT:    movw ax, [hl]
; PINNED-NEXT:    movw hl, ax
; PINNED-NEXT:    cmpw ax, #0
; PINNED-NEXT:    bnz $.LBB0_2
; PINNED-NEXT:  .LBB0_4: ; %done
; PINNED-NEXT:    movw ax, de
; PINNED-NEXT:    ret
; PINNED-NEXT:  .LBB0_3:
; PINNED-NEXT:    push hl
; PINNED-NEXT:    pop de
; PINNED-NEXT:    movw ax, de
; PINNED-NEXT:    ret
entry:
  %e = icmp eq ptr %n, null
  br i1 %e, label %done, label %loop

loop:
  %p = phi ptr [ %n, %entry ], [ %next, %cont ]
  %kp = getelementptr inbounds i8, ptr %p, i16 2
  %k = load i16, ptr %kp, align 2
  %hit = icmp eq i16 %k, %key
  br i1 %hit, label %done, label %cont

cont:
  %next = load ptr, ptr %p, align 2
  %end = icmp eq ptr %next, null
  br i1 %end, label %done, label %loop

done:
  %r = phi ptr [ null, %entry ], [ %p, %loop ], [ null, %cont ]
  ret ptr %r
}
