; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; Test for replacing the BT a.bit + AND a, #mask with a BTCLR.
; FIXME: The BTCLR is not formed: RL78SelectBTCLR only removes the clear from
; a block that the branch alone enters, and here the fall-through path of the
; same branch enters it too (the bit is known clear there).
; RUN: llc -mtriple=rl78 < %s | FileCheck %s

@g_cmd_flag.0 = global i8 0

define void @R_WDT_Restart()  {
; CHECK-LABEL: R_WDT_Restart:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    mov 0xfffab, #-84
; CHECK-NEXT:    ret
entry:
  store volatile i8 -84, ptr inttoptr (i16 -85 to ptr)
  ret void
}

define void @test()  {
; CHECK-LABEL: test:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    push ax
; CHECK-NEXT:    mov x, !LOWW(_g_cmd_flag.0)
; CHECK-NEXT:    mov a, x
; CHECK-NEXT:    bt a.1, $.LBB1_2
; CHECK-NEXT:  ; %bb.1: ; %if.then
; CHECK-NEXT:    mov a, x
; CHECK-NEXT:    mov [sp+0], a
; CHECK-NEXT:    call !_R_WDT_Restart
; CHECK-NEXT:    mov a, [sp+0]
; CHECK-NEXT:    mov x, a
; CHECK-NEXT:  .LBB1_2: ; %if.end
; CHECK-NEXT:    mov a, x
; CHECK-NEXT:    and a, #-3
; CHECK-NEXT:    mov !LOWW(_g_cmd_flag.0), a
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    br !_R_WDT_Restart
entry:
  %bf.load = load i8, ptr @g_cmd_flag.0
  %bf.shl.mask = and i8 %bf.load, 2
  %cmp = icmp eq i8 %bf.shl.mask, 0
  br i1 %cmp, label %if.then, label %if.end

if.then:
  tail call void @R_WDT_Restart() #2
  br label %if.end

if.end:
  %bf.clear = and i8 %bf.load, -3
  store i8 %bf.clear, ptr @g_cmd_flag.0, align 2
  tail call void @R_WDT_Restart() #2
  ret void
}

