; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    and a, #127
; CHECK-NEXT:    or a, x
; CHECK-NEXT:    or a, e
; CHECK-NEXT:    or a, d
; CHECK-NEXT:    bz $.LBB0_1
; CHECK-NEXT:  ; %bb.2:
; CHECK-NEXT:    clrw ax
; CHECK-NEXT:    mov a, x
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    onew ax
; CHECK-NEXT:    mov a, x
; CHECK-NEXT:    ret
  %c = fcmp oeq float %x, 0.0
  ret i1 %c
}

