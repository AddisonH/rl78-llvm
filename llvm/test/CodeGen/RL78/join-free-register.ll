; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; A value that an instruction needs in one register (AX for CMPW here) stays
; in that register from its definition when nothing else needs the register
; in between: the high word of the first operand is loaded into AX. The low
; word cannot be (the compare of the high words needs AX first), and neither
; can a value that lives across something else in AX.
; RUN: llc -verify-machineinstrs -mtriple=rl78 < %s | FileCheck %s

@a = global [6 x i32] zeroinitializer
@m = global i32 0

define void @compare32() {
; CHECK-LABEL: compare32:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw ax, !LOWW(_a+2)
; CHECK-NEXT:    movw bc, !LOWW(_a)
; CHECK-NEXT:    movw de, !LOWW(_a+10)
; CHECK-NEXT:    movw hl, !LOWW(_a+8)
; CHECK-NEXT:    cmpw ax, de
; CHECK-NEXT:    xor1 cy, a.7
; CHECK-NEXT:    mov a, d
; CHECK-NEXT:    xor1 cy, a.7
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    sknz
; CHECK-NEXT:    cmpw ax, hl
; CHECK-NEXT:    bnc $.LBB0_2
; CHECK-NEXT:  ; %bb.1: ; %then
; CHECK-NEXT:    clrw ax
; CHECK-NEXT:    movw !LOWW(_m+2), ax
; CHECK-NEXT:    movw ax, #7
; CHECK-NEXT:    movw !LOWW(_m), ax
; CHECK-NEXT:  .LBB0_2: ; %end
; CHECK-NEXT:    ret
  %x = load volatile i32, ptr @a
  %y = load volatile i32, ptr getelementptr inbounds ([6 x i32], ptr @a, i16 0, i16 2)
  %c = icmp slt i32 %x, %y
  br i1 %c, label %then, label %end

then:
  store volatile i32 7, ptr @m
  br label %end

end:
  ret void
}

; DE or HL as a base register: the pointer stays in one of them across both
; loads instead of being copied into HL for each.
define i16 @base_register(ptr %p) {
; CHECK-LABEL: base_register:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw hl, ax
; CHECK-NEXT:    movw ax, [hl+2]
; CHECK-NEXT:    addw ax, [hl+6]
; CHECK-NEXT:    ret
  %q = getelementptr inbounds i8, ptr %p, i16 2
  %x = load i16, ptr %q
  %r = getelementptr inbounds i8, ptr %p, i16 6
  %y = load i16, ptr %r
  %s = add i16 %x, %y
  ret i16 %s
}
