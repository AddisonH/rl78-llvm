; A value of several words is shifted by one through the carry: SHLW AX, 1
; and ROLWC for each word above to the left; SHRW or SARW AX, 1 and RORC on
; the bytes of each word below to the right. The generic expansion takes the
; bit that crosses each word boundary with a shift of its own.

define i32 @shl32(i32 %x) {
; CHECK-LABEL: shl32:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    shlw ax, 1
; CHECK-NEXT:    rolwc bc, 1
; CHECK-NEXT:    ret
  %r = shl i32 %x, 1
  ret i32 %r
}

