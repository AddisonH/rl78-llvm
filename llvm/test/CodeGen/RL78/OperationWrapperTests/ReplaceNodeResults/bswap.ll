; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; This test verifies the i32 and i64 BSWAPs.
; The i64 variant recursively emits EXTRACT_ELEMENTs as it performs swaps on each half before recombining them.
; The i32 variant just swaps the high part with the low part of the node.

; RUN: llc -mtriple=rl78 %s -o - | FileCheck %s


define dso_local void @aa(ptr noalias nocapture writeonly sret(i64) align 2 %0, i64 noundef %1) local_unnamed_addr #0 {
; CHECK-LABEL: aa:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    movw ax, [sp+4]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    push bc
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    movw [hl+6], ax
; CHECK-NEXT:    movw ax, [sp+6]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    movw [hl+4], ax
; CHECK-NEXT:    movw ax, [sp+8]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    movw [hl+2], ax
; CHECK-NEXT:    movw ax, [sp+10]
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    movw [hl], ax
; CHECK-NEXT:    movw ax, bc
; CHECK-NEXT:    ret
  %3 = tail call i64 @llvm.bswap.i64(i64 %1)
  store i64 %3, ptr %0, align 2
  ret void
}

declare i64 @llvm.bswap.i64(i64) #1


define dso_local i32 @ab(i32 noundef %0) local_unnamed_addr #2 {
; CHECK-LABEL: ab:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    xchw ax, bc
; CHECK-NEXT:    xch a, x
; CHECK-NEXT:    ret
  %2 = tail call i32 @llvm.bswap.i32(i32 %0)
  ret i32 %2
}

declare i32 @llvm.bswap.i32(i32) #1
