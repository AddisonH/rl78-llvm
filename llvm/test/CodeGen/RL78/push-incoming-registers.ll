; STORE-NEXT:    ret
  %x = call i16 @g(i16 %a)
  %y = call i16 @g(i16 %b)
  %z = call i16 @g(i16 %c)
  %s1 = add i16 %x, %y
  %s2 = add i16 %s1, %z
  %s3 = add i16 %s2, %a
  %s4 = add i16 %s3, %b
  %s5 = add i16 %s4, %c
  ret i16 %s5
}

; One spilled register is the whole frame.
define i16 @one(i16 %a) {
; CHECK-LABEL: one:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push ax
; CHECK-NEXT:    call !_g
; CHECK-NEXT:    movw hl, sp
; CHECK-NEXT:    addw ax, [hl+0]
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    ret
;
; STORE-LABEL: one:
; STORE:       ; %bb.0:
; STORE-NEXT:    push ax
; STORE-NEXT:    call !_g
; STORE-NEXT:    movw hl, sp
; STORE-NEXT:    addw ax, [hl+0]
; STORE-NEXT:    pop hl
; STORE-NEXT:    ret
  %x = call i16 @g(i16 %a)
  %s = add i16 %x, %a
  ret i16 %s
}

