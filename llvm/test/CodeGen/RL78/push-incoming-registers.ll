; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -verify-machineinstrs -mtriple=rl78 < %s | FileCheck %s

; Arguments that are spilled on entry are pushed: their slots are the
; highest of the frame and the rest is allocated below them.

declare i16 @g(i16)

; Three spilled registers. The frame has a fourth word, allocated by a push
; of its own.
define i16 @three(i16 %a, i16 %b, i16 %c) {
; CHECK-LABEL: three:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push de
; CHECK-NEXT:    push bc
; CHECK-NEXT:    push ax
; CHECK-NEXT:    push ax
; CHECK-NEXT:    movw ax, [sp+2] ; 2-byte Folded Reload
; CHECK-NEXT:    call !_g
; CHECK-NEXT:    movw [sp+0], ax ; 2-byte Folded Spill
; CHECK-NEXT:    movw ax, [sp+4] ; 2-byte Folded Reload
; CHECK-NEXT:    call !_g
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:    addw ax, bc
; CHECK-NEXT:    movw [sp+0], ax ; 2-byte Folded Spill
; CHECK-NEXT:    movw ax, [sp+6] ; 2-byte Folded Reload
; CHECK-NEXT:    call !_g
; CHECK-NEXT:    movw bc, ax
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:    movw hl, sp
; CHECK-NEXT:    addw ax, bc
; CHECK-NEXT:    addw ax, [hl+2] ; 2-byte Folded Reload
; CHECK-NEXT:    addw ax, [hl+4] ; 2-byte Folded Reload
; CHECK-NEXT:    addw sp, #8
; CHECK-NEXT:    addw ax, [hl+6] ; 2-byte Folded Reload
; CHECK-NEXT:    ret
;
  %x = call i16 @g(i16 %a)
  %y = call i16 @g(i16 %b)
  %z = call i16 @g(i16 %c)
  %s1 = add i16 %x, %y
  %s2 = add i16 %s1, %z
  %s3 = add i16 %s2, %a
  %s4 = add i16 %s3, %b
  %s5 = add i16 %s4, %c
  ret i16 %s5
}

; One spilled register is the whole frame.
define i16 @one(i16 %a) {
; CHECK-LABEL: one:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    push ax
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:    call !_g
; CHECK-NEXT:    movw hl, sp
; CHECK-NEXT:    addw ax, [hl+0] ; 2-byte Folded Reload
; CHECK-NEXT:    pop hl
; CHECK-NEXT:    ret
;
  %x = call i16 @g(i16 %a)
  %s = add i16 %x, %a
  ret i16 %s
}

; The array makes the frame larger than [SP+byte] reaches. The slot of %a
; stays near SP and is stored to.
define i16 @large(i16 %a) {
; CHECK-LABEL: large:
; CHECK:       ; %bb.0:
; CHECK-NEXT:    subw sp, #254
; CHECK-NEXT:    subw sp, #48
; CHECK-NEXT:    movw [sp+0], ax ; 2-byte Folded Spill
; CHECK-NEXT:    movw ax, sp
; CHECK-NEXT:    addw ax, #2
; CHECK-NEXT:    call !_h
; CHECK-NEXT:    movw ax, [sp+0] ; 2-byte Folded Reload
; CHECK-NEXT:    call !_g
; CHECK-NEXT:    movw hl, sp
; CHECK-NEXT:    addw sp, #254
; CHECK-NEXT:    addw sp, #48
; CHECK-NEXT:    addw ax, [hl+0] ; 2-byte Folded Reload
; CHECK-NEXT:    ret
;
  %buf = alloca [300 x i8]
  call void @h(ptr %buf)
  %x = call i16 @g(i16 %a)
  %s = add i16 %x, %a
  ret i16 %s
}

declare void @h(ptr)
